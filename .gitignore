# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# crawl snapshots and job JSON
/storage/

# craftum research captures (may contain API secrets)
/docs/craftum-blocks-research/captured/*.json
/docs/craftum-blocks-research/captured/pw-extension-profile/

# accidental dumps
/www.zip

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.originkit/
*.bak-test
