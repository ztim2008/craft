{
  "manifest_version": 3,
  "name": "Craftum Blocks MVP",
  "version": "0.5.4",
  "description": "Мои блоки — вставка на канву Craftum",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Craftum Blocks",
    "default_popup": "popup/popup.html"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://craftum.com/*",
    "https://api-v2.craftum.com/*",
    "https://craft.nordic-builder.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://craftum.com/*"],
      "js": ["content/craftum-api.js", "content/editor.js"],
      "css": ["content/editor.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/page-world.js", "icons/icon48.png", "icons/icon128.png"],
      "matches": ["https://craftum.com/*"]
    }
  ]
}
